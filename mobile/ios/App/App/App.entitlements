<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: /auth/callback on the site opens the app (the site
	     serves /.well-known/apple-app-site-association with the Team ID). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.thabangvision.com</string>
		<string>webcredentials:www.thabangvision.com</string>
	</array>
</dict>
</plist>
